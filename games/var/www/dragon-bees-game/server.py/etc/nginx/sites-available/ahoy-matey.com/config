server {
    server_name ahoy-matey.com www.ahoy-matey.com;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ahoy-matey.com www.ahoy-matey.com;

    ssl_certificate /etc/letsencrypt/live/ahoy-matey.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ahoy-matey.com/privkey.pem;

    root /var/www/dragon-bees-game/public;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location /socket.io/ {
        proxy_pass http://127.0.0.1:5000;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}
